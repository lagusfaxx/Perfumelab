# ─────────────────────────────────────────────────────────────
# Perfume Lab Chile — variables de entorno
# Copia este archivo a `.env` y completa los valores.
# NUNCA comitees el `.env` real.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# URL pública del sitio (sin slash final). Usada por FLOW (urlReturn/urlConfirmation),
# metadata/OpenGraph, sitemap y robots.
APP_URL=http://localhost:3000

# ── Base de datos (PostgreSQL) ───────────────────────────────
# En docker-compose el host es `db`. En local apunta a tu Postgres.
DATABASE_URL=postgresql://perfumelab:perfumelab@localhost:5432/perfumelab?schema=public
# Credenciales del contenedor Postgres (sólo las usa docker-compose):
POSTGRES_USER=perfumelab
POSTGRES_PASSWORD=perfumelab
POSTGRES_DB=perfumelab

# ── FLOW (pasarela de pago chilena) ──────────────────────────
# Obtén las llaves en https://www.flow.cl (sección integración).
FLOW_API_KEY=tu_api_key_de_flow
FLOW_SECRET_KEY=tu_secret_key_de_flow
# Sandbox para pruebas | Producción: https://www.flow.cl/api
FLOW_API_URL=https://sandbox.flow.cl/api

# ── Admin (panel privado) ────────────────────────────────────
# Secreto para firmar la sesión JWT del admin. Genera uno largo y aleatorio:
#   openssl rand -base64 48
ADMIN_SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Credenciales del primer admin (se crea en el seed si no existe).
ADMIN_EMAIL=admin@perfumelabchile.cl
ADMIN_PASSWORD=cambia-esta-clave

# ── Email transaccional (Resend) ─────────────────────────────
# Opcional: si se deja vacío, los emails se omiten (no rompe el flujo).
# Consigue la API key en https://resend.com
RESEND_API_KEY=
# Remitente verificado en tu dominio de Resend.
EMAIL_FROM=Perfume Lab <pedidos@perfumelabchile.cl>

# ── docker-compose (opcional) ────────────────────────────────
# Puerto host expuesto por el contenedor web.
WEB_PORT=3000
